,{"h":"另","p":"lìng"},{"h":"一","p":"yí"},{"h":"个","p":"gè"},{"h":"有名","p":"yǒumíng"},{"h":"的","p":"de"},{"h":"传说","p":"chuánshuō"},{"h":"了","p":"le"},{"h":"。","p":"."}]]}],"glossary":[{"w":"太阳","fr":"soleil","en":"sun","p":"tàiyáng"},{"w":"温暖","fr":"chaleur douce","en":"warmth","p":"wēnnuǎn"},{"w":"粮食","fr":"céréales, récoltes","en":"grain, crops","p":"liángshí"},{"w":"无聊","fr":"ennuyeux, s'ennuyer","en":"bored, boring","p":"wúliáo"},{"w":"躲","fr":"se cacher","en":"to hide","p":"duǒ"},{"w":"射箭","fr":"tirer à l'arc","en":"to shoot arrows","p":"shèjiàn"},{"w":"弓 / 箭","fr":"arc / flèche","en":"bow / arrow","p":"gōng / jiàn"},{"w":"乌鸦","fr":"corbeau","en":"crow","p":"wūyā"},{"w":"剩下","fr":"rester (il reste)","en":"to be left over","p":"shèngxià"},{"w":"英雄","fr":"héros","en":"hero","p":"yīngxióng"}],"questions":[{"q":{"fr":"Où vivent les dix soleils ?","en":"Where do the ten suns live?"},"options":[{"fr":"Dans une grotte","en":"In a cave"},{"fr":"Sur un grand arbre dans la mer de l'Est","en":"On a big tree in the eastern sea"},{"fr":"Au sommet d'une montagne","en":"On top of a mountain"},{"fr":"Derrière la lune","en":"Behind the moon"}],"answer":1,"why":{"fr":"« zhù zài dōngbian dà hǎi lǐ de yì kē dà shù shàng ».","en":"“zhù zài dōngbian dà hǎi lǐ de yì kē dà shù shàng”."}},{"q":{"fr":"Normalement, combien de soleils sortent chaque jour ?","en":"Normally, how many suns come out each day?"},"options":[{"fr":"Un seul","en":"Only one"},{"fr":"Deux","en":"Two"},{"fr":"Cinq","en":"Five"},{"fr":"Dix","en":"Ten"}],"answer":0,"why":{"fr":"« zhǐ yǒu yí gè tàiyáng chūlai gōngzuò ».","en":"“zhǐ yǒu yí gè tàiyáng chūlai gōngzuò”."}},{"q":{"fr":"Pourquoi les dix soleils sortent-ils ensemble ?","en":"Why do the ten suns go out together?"},"options":[{"fr":"Leur père le leur demande","en":"Their father tells them to"},{"fr":"Ils s'ennuient et veulent s'amuser","en":"They are bored and want to have fun"},{"fr":"Ils veulent punir les hommes","en":"They want to punish people"},{"fr":"Il fait trop froid sur terre","en":"It is too cold on earth"}],"answer":1,"why":{"fr":"Ils trouvent l'attente wúliáo (ennuyeuse) : « wǒmen yìqǐ chūqù wán ba! »","en":"They find waiting wúliáo (boring): “wǒmen yìqǐ chūqù wán ba!”"}},{"q":{"fr":"Où se cachent les survivants ?","en":"Where do the survivors hide?"},"options":[{"fr":"Dans la rivière","en":"In the river"},{"fr":"Dans des grottes","en":"In caves"},{"fr":"Sous les arbres","en":"Under the trees"},{"fr":"Dans leurs maisons","en":"In their houses"}],"answer":1,"why":{"fr":"« zhǐnéng duǒ zài shāndòng lǐ ».","en":"“zhǐnéng duǒ zài shāndòng lǐ”."}},{"q":{"fr":"Quel est le talent de Houyi ?","en":"What is Houyi's talent?"},"options":[{"fr":"Il nage très bien","en":"He swims very well"},{"fr":"Il tire à l'arc à merveille","en":"He is a superb archer"},{"fr":"Il chante très bien","en":"He sings beautifully"},{"fr":"Il fabrique des maisons","en":"He builds houses"}],"answer":1,"why":{"fr":"« shèjiàn shè de tèbié hǎo », il touche une feuille à cent pas.","en":"“shèjiàn shè de tèbié hǎo”: he can hit a leaf from a hundred paces."}},{"q":{"fr":"Que devient un soleil touché par une flèche ?","en":"What does a sun turn into when it is hit?"},"options":[{"fr":"Une étoile","en":"A star"},{"fr":"Un corbeau doré à trois pattes","en":"A golden three-legged crow"},{"fr":"Une pierre","en":"A stone"},{"fr":"Un nuage","en":"A cloud"}],"answer":1,"why":{"fr":"« biànchéng yì zhī jīnsè de sān jiǎo wūyā ».","en":"“biànchéng yì zhī jīnsè de sān jiǎo wūyā”."}},{"q":{"fr":"Pourquoi Houyi ne tire-t-il pas sur le dernier soleil ?","en":"Why doesn't Houyi shoot the last sun?"},"options":[{"fr":"Il n'a plus de flèches","en":"He has no arrows left"},{"fr":"Un vieil homme lui explique qu'on a besoin d'un soleil","en":"An old man explains that people need one sun"},{"fr":"Le soleil est trop loin","en":"The sun is too far away"},{"fr":"Il est trop fatigué","en":"He is too tired"}],"answer":1,"why":{"fr":"Sans soleil, le monde serait « yòu lěng yòu hēi » et rien ne pousserait.","en":"Without a sun the world would be “yòu lěng yòu hēi” and nothing would grow."}},{"q":{"fr":"Quelle conséquence l'exploit de Houyi a-t-il pour lui ?","en":"What happens to Houyi because of what he did?"},"options":[{"fr":"Il devient roi","en":"He becomes king"},{"fr":"L'Empereur céleste lui interdit de revenir au ciel","en":"The Heavenly Emperor forbids him to return to heaven"},{"fr":"Il perd sa femme","en":"He loses his wife"},{"fr":"Il devient un soleil","en":"He becomes a sun"}],"answer":1,"why":{"fr":"Tiāndì, qui a perdu neuf enfants, ne le laisse plus revenir au ciel.","en":"Tiāndì, who lost nine children, no longer lets him go back to heaven."}}],"chars":714}