# Supabase (client-side, safe to expose: protected by Row Level Security)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Optional: Gemini key for the AI-generated "Chinese Daily" widget.
# Without it, the widget uses the built-in curated library.
GEMINI_API_KEY=""

# Laoshi (AI tutor) — shared free key used for every student's daily free messages.
# Free Groq key (no bank card): https://console.groq.com/keys
GROQ_API_KEY=""
# Optional overrides (defaults: groq · qwen/qwen3.8-27b, fallback openai/gpt-oss-120b)
# TUTOR_PROVIDER="groq"
# TUTOR_MODEL=""
# TUTOR_FALLBACK_MODEL=""
